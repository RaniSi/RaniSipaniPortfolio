# Copy this file to .env and fill in your values. NEVER commit .env to git.
# In production, set these as environment variables in your Vercel project settings.

# Required — your Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=""

# Optional — sender address. Must be a verified domain in Resend,
# or use "onboarding@resend.dev" to test sending to your own email.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Optional — where to deliver messages (comma-separated list allowed)
RESEND_TO_EMAIL="you@example.com"